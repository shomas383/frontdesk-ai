# Copy to .env and fill in. Never commit .env.

# --- LLM ---
LLM_PROVIDER=anthropic            # anthropic | bedrock
LLM_MODEL=claude-haiku-5-5        # used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Bedrock (later milestone). Use a "us." cross-region inference profile ID.
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=

# --- Retrieval ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/frontdesk
EMBED_MODEL=BAAI/bge-m3
