# Copy to .env and fill in. Never commit .env.

# --- LLM ---
LLM_PROVIDER=anthropic            # anthropic | bedrock
LLM_MODEL=claude-haiku-5-5        # used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Bedrock (later milestone). Use a "us." cross-region inference profile ID.
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=

# --- Retrieval ---
# docker compose's app service overrides this with the in-network address (db:5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/frontdesk
EMBED_MODEL=BAAI/bge-m3

# --- API (src/app.py) ---
# Comma-separated tenants /chat accepts; anything else gets 404. Also ingested on first Docker start.
ALLOWED_TENANTS=komorebi-seitai-demo
# Longer messages are rejected with 422.
MAX_MESSAGE_CHARS=300
# Per client IP, in process memory (run a single uvicorn worker). Over the limit: 429 + Retry-After.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=50
# Global, per JST day, stored in Postgres (usage_daily). Over either one, /chat answers with a polite
# "please call or LINE the clinic" message, behavior=handoff, and the LLM is not called.
DAILY_QUESTION_CAP=500
DAILY_TOKEN_BUDGET=2000000        # input + output tokens (~500 questions, ~$0.25 on Haiku 5.5)
# Date the docs' notices are judged against. Empty = today in Asia/Tokyo; 2026-10-24 matches eval.
APP_TODAY=
# true only behind a trusted proxy/load balancer: rate-limit by the right-most X-Forwarded-For entry.
TRUST_PROXY_HEADERS=false
# Comma-separated browser origins allowed to call the API (e.g. the web chat). Empty = no CORS.
CORS_ORIGINS=
# true lets the web page auto-send questions from ?demo=q1|q2 (screenshots / demo video only).
DEMO_AUTOSEND=false
# Host port for `docker compose --profile app up` (compose only).
APP_PORT=8000
