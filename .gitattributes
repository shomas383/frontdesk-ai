# Files that run on Linux (containers, the EC2 host, Terraform's templatefile) stay LF in the
# Windows working tree too; core.autocrlf=true would otherwise check them out as CRLF.
*.sh text eol=lf
*.tftpl text eol=lf
Caddyfile text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.yml text eol=lf
Dockerfile text eol=lf
# Everything shipped to the host (tests/test_deploy_files.py checks for stray \r here).
deploy/** text eol=lf
infra/host/** text eol=lf
# Images shipped with the demo homepage are binary (after deploy/** so this wins).
*.webp binary
# The LINE rich menu image (scripts/line_rich_menu.py).
*.png binary
