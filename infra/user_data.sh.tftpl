#!/bin/bash
# First-boot setup for the frontdesk-ai host (Amazon Linux 2023). cloud-init runs this once, as root,
# when the instance is first created; output goes to /var/log/cloud-init-output.log.
# It prepares the host only. The app arrives through frontdesk-deploy.timer once a release exists.
#
# This file is a Terraform template (compute.tf): a dollar sign followed by a brace is Terraform
# interpolation, filled in before the instance sees the script. Write shell variables as $VAR; if you
# need braces, double the dollar sign ($$ then {VAR}) and Terraform emits a single one.
set -euxo pipefail

# --- 1. Swap: 2 GB safety net for memory peaks (ingest + Docker on a 2 GB box) ---------------------
# Runs as root at first boot, so no sudo. Guarded so a second run is harmless. First, so the headroom
# exists before Docker and the deploy timer start anything heavy.
# Swap is a nice-to-have: if a step fails, warn and continue rather than let `set -e` abort the boot
# (no Docker, no timer). The steps are chained with && because bash ignores `set -e` inside a
# command whose status is tested (left of ||, or an if condition).
if ! swapon --show=NAME --noheadings | grep -qx /swapfile; then
  if fallocate -l 2G /swapfile &&   # reserve a 2 GB file on disk (instant)
     chmod 600 /swapfile &&        # root-only: swap can hold copies of memory, incl. secrets
     mkswap /swapfile &&           # format the file as swap space
     swapon /swapfile; then        # start using it now
    grep -q '^/swapfile ' /etc/fstab ||
      echo '/swapfile none swap defaults 0 0' >> /etc/fstab   # ...and after every reboot
  else
    echo "WARNING: swap setup failed; continuing without swap" >&2
    rm -f /swapfile
  fi
fi

# Swappiness 0-100: how strongly the kernel prefers swapping process memory over dropping file cache
# when it needs RAM. Default 60; 10 keeps swap as an emergency buffer, not normal operation.
echo 'vm.swappiness=10' > /etc/sysctl.d/99-swap.conf   # persists across reboots
sysctl -p /etc/sysctl.d/99-swap.conf                    # apply now

# --- 2. Docker and the Compose plugin ---------------------------------------------------------------
dnf install -y docker
systemctl enable --now docker

# AL2023's repositories don't ship the Compose v2 plugin; install the pinned release and check its hash.
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
  "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64"
echo "${compose_sha256}  /usr/local/lib/docker/cli-plugins/docker-compose" | sha256sum -c -
chmod 755 /usr/local/lib/docker/cli-plugins/docker-compose
docker compose version

# --- 3. Pull-based deploy -------------------------------------------------------------------------
# pull-deploy.sh runs every 2 minutes; it deploys a new ${image_repo}:${deploy_tag} digest with the
# deploy.sh shipped inside that image, and rolls back if it fails (infra/host/pull-deploy.sh).
mkdir -p /opt/frontdesk/state /etc/frontdesk
chmod 700 /opt/frontdesk  # .env holds the secrets
echo '${pull_deploy_b64}' | base64 -d > /opt/frontdesk/pull-deploy.sh
chmod 755 /opt/frontdesk/pull-deploy.sh
echo '${deploy_service_b64}' | base64 -d > /etc/systemd/system/frontdesk-deploy.service
echo '${deploy_timer_b64}' | base64 -d > /etc/systemd/system/frontdesk-deploy.timer

# Settings for pull-deploy.sh and deploy.sh (also used by compose to interpolate compose.prod.yml).
cat > /etc/frontdesk/deploy.env <<'EOF'
IMAGE_REPO=${image_repo}
DEPLOY_TAG=${deploy_tag}
PARAM_PATH=${param_path}
LOG_GROUP=${log_group}
AWS_REGION=${region}
FRONTDESK_HOME=/opt/frontdesk
EOF

systemctl daemon-reload
systemctl enable --now frontdesk-deploy.timer
