{
	# There is no access log (no `log` directive in the site below): it would record client IPs.
	# Caddy still logs errors, and a proxy error (e.g. a 502 while the app restarts) carries the
	# request, so strip the client address and headers before the line reaches CloudWatch.
	# Some loggers put the peer at the top level instead (the ACME HTTP-01 handler's "served key
	# authentication" line has "remote": the Let's Encrypt validator), so delete those names too.
	log default {
		output stderr
		format filter {
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers delete
			remote delete
			remote_ip delete
			client_ip delete
		}
	}
}

# DOMAIN comes from compose (demo.shomasawa.com in production). Caddy gets and renews the
# Let's Encrypt certificate itself and redirects HTTP to HTTPS.
{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:8000
}

# The fictional clinic's homepage (komorebi.shomasawa.com in production): static files from
# deploy/sites/komorebi, embedding the chat with one <script> tag like a real client site would.
# Its only third party is us: widget.js from {$DOMAIN}, which frames {$DOMAIN}/embed.
{$HOMEPAGE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'none'; script-src 'self' https://{$DOMAIN}; frame-src https://{$DOMAIN}; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	root * /srv/komorebi
	file_server
}
